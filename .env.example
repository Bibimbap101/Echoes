# Copy this file to .env and fill it in. Never commit .env.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI in the Spotify dashboard EXACTLY. "localhost" is not allowed.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Last.fm login (no user limit). Make an API account at https://www.last.fm/api/account/create
# and set its Callback URL to <your site>/api/auth/lastfm/callback.
LASTFM_API_KEY=
LASTFM_SECRET=

# Any long random string. Signs your login cookie and encrypts saved Spotify logins.
SESSION_SECRET=

MONGODB_URI=mongodb://127.0.0.1:27017/echoes
PORT=3001

# Your timezone. Decides when your "day" starts (today's minutes, streaks, listening clock).
TIMEZONE=Asia/Manila
# A play counts as a "stream" only if you listened at least this long (ms). Spotify uses 30 seconds.
STREAM_MIN_MS=30000

# Only needed when hosted (Vercel): a long random string. The 30-minute timer must send it as
# "Authorization: Bearer <CRON_SECRET>" when it calls /api/cron.
CRON_SECRET=
